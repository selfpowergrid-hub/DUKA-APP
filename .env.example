# Copy to .env.local and fill in from your Supabase project: Settings -> API.
#
# Both are NEXT_PUBLIC_, meaning they are shipped to the browser by design.
# The anon key is not a secret — it identifies the project, and Row Level
# Security is what actually protects the data. Never put the service_role key
# here or anywhere else in this repo: that one bypasses RLS entirely.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
