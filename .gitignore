# Dependencies and build output
node_modules/
.next/
out/
build/
*.tsbuildinfo

# Environment. duka-lite/.env.local is deliberately tracked — see the note in
# duka-lite/.gitignore. Anything else matching stays out; a service_role key
# must never be committed, since it bypasses Row Level Security entirely.
.env
.env.*
!.env.example
!duka-lite/.env.local

# Generated at build time by scripts/build-sw.mjs (stamped with a timestamp)
duka-lite/public/sw.js

# Screenshots written by the responsive check
duka-lite/test/screenshots/

# OS / editor noise
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
